# Public URLs
PUBLIC_APP_URL=https://fibreconnect.example
CORS_ORIGINS=https://fibreconnect.example

# Set both values with Netlify context-specific Functions scope. Netlify's
# automatic CONTEXT variable is build-only, not available to Functions runtime.
APP_DEPLOYMENT_CONTEXT=
DATABASE_DEPLOYMENT_CONTEXT=

# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
SESSION_COOKIE_NAME=fc_session
SESSION_TTL_HOURS=168
# Optional Cloudflare Turnstile secret. When present, protected public mutations require x-bot-token.
BOT_PROTECTION_SECRET=

# Transactional email (server-only; Resend domain/sender verification required for production)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@fibreconnect.example
EMAIL_FROM_NAME=FibreConnect SA
EMAIL_PROVIDER_TIMEOUT_MS=8000

# PostgreSQL (replace locally; never commit a real credential)
DATABASE_URL=postgresql://fibreconnect:fibreconnect@localhost:5432/fibreconnect?schema=public
DIRECT_URL=postgresql://fibreconnect:fibreconnect@localhost:5432/fibreconnect?schema=public
# Optional Supabase project metadata. Never place real values in this example.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
